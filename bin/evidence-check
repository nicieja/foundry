#!/bin/sh
# The pre-registration lock of docs/engineering/evidence.md: a bar is committed
# before the evidence it judges, and never changes after.
set -e
cd "$(dirname "$0")/.."

failed=0
reject() {
  echo "$1: $2"
  failed=1
}

first_commit() {
  git log --diff-filter=A --format=%H -- "$1" | tail -1
}

for bar in docs/evidence/*/*/bar.md; do
  [ -f "$bar" ] || continue
  rung=${bar%/bar.md}
  verdict=$rung/verdict.md

  evidence=""
  [ -f "$verdict" ] && evidence="$verdict"
  for transcript in "$rung"/t-*.md; do
    [ -f "$transcript" ] && evidence="$evidence $transcript"
  done
  [ -n "$evidence" ] || continue

  bar_commit=$(first_commit "$bar")
  if [ -z "$bar_commit" ]; then
    reject "$bar" "never committed, so it was never registered"
    continue
  fi

  git show "$bar_commit:$bar" | cmp -s - "$bar" ||
    reject "$bar" "changed since it was registered in $bar_commit"

  for file in $evidence; do
    file_commit=$(first_commit "$file")
    [ -n "$file_commit" ] || continue
    if [ "$bar_commit" = "$file_commit" ]; then
      reject "$bar" "registered in the same commit as $file"
    elif ! git merge-base --is-ancestor "$bar_commit" "$file_commit"; then
      reject "$bar" "registered after $file, in $bar_commit"
    fi
  done

  [ -f "$verdict" ] || continue
  for cited in $(grep -o 't-[0-9][0-9]*\.md' "$verdict" | sort -u); do
    [ -f "$rung/$cited" ] || reject "$verdict" "cites a missing $cited"
  done
done

[ "$failed" = 0 ] || exit 1
echo "evidence-check: ok"
